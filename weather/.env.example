# Server Configuration
PORT=3000
NODE_ENV=development

# XWeather API Credentials
# Get these from https://www.xweather.com/
XWEATHER_CLIENT_ID=your_xweather_client_id
XWEATHER_CLIENT_SECRET=your_xweather_client_secret

# x402 Payment Configuration
# Your wallet address that will receive USDC payments
PAYMENT_RECIPIENT_ADDRESS=0xYourEVMWalletAddress

# Payment Network: "base", "base-mainnet", or "base-sepolia"
PAYMENT_NETWORK=base

# Facilitator URL for payment verification
# Base Mainnet: https://x402.org/facilitator
# Base Sepolia: https://x402.org/facilitator/base-sepolia
FACILITATOR_URL=https://x402.org/facilitator

# Pricing (in USDC smallest units - 6 decimals)
# 1 USDC = 1,000,000 units
# 0.001 USDC = 1000 units
PRICE_CURRENT_WEATHER=1000
PRICE_FORECAST=2000
PRICE_ALERTS=1500
